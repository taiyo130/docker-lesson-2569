server {
    listen 80;
    root /usr/share/nginx/html;

    # Docker embedded DNS (มีเฉพาะใน user-defined network)
    # ใช้ตัวแปร + resolver เพื่อให้ nginx start ได้แม้ api ยังไม่รัน และตามทัน IP ใหม่เมื่อ api ถูกสร้างใหม่
    resolver 127.0.0.11 valid=10s ipv6=off;

    location /api/ {
        set $api_upstream http://${API_UPSTREAM};
        proxy_pass $api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # React เป็น SPA — path ที่ไม่ใช่ไฟล์ให้ส่ง index.html
    location / {
        try_files $uri /index.html;
    }
}
